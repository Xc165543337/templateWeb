# JWT Configuration
ACCESS_TOKEN_SECRET=your-super-secret-key-change-this
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-this
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Server Configuration
PORT=443

# Note: Remember to rename this file to '.env' and update the values with your actual configuration before running the application.
